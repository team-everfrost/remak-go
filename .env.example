APP_ENV=development
HTTP_ADDR=:8080
DATABASE_URL=postgres://remak:remak@localhost:5432/remak?sslmode=disable
JWT_SECRET=local-development-secret-change-me
JWT_ISSUER=remak-local
CHALLENGE_SECRET=local-challenge-secret-change-me
EXPOSE_DEBUG_VERIFICATION_CODES=true
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h
AWS_REGION=ap-northeast-2
AWS_ENDPOINT_URL=http://localhost:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
SCRAPE_REQUEST_QUEUE_URL=http://localhost:4566/000000000000/remak-scrape-request
SCRAPE_RESULT_QUEUE_URL=http://localhost:4566/000000000000/remak-scrape-result
ARTIFACT_BUCKET=remak-artifacts
DOCUMENT_BUCKET=remak-documents
EMAIL_FROM=
QUEUE_POLL_WAIT=2s
OUTBOX_POLL_INTERVAL=1s
AI_BASE_URL=
AI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
CHAT_MODEL=gpt-4.1-mini
ENRICHMENT_BATCH_SIZE=4
