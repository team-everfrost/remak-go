REMAK_DOMAIN=api.example.com
POSTGRES_DB=remak
POSTGRES_USER=remak
POSTGRES_PASSWORD=change-me
APP_ENV=production
HTTP_ADDR=:8080
DATABASE_URL=postgres://remak:change-me@postgres:5432/remak?sslmode=disable
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_ISSUER=https://api.example.com
CHALLENGE_SECRET=replace-with-at-least-32-random-characters
EXPOSE_DEBUG_VERIFICATION_CODES=false
ALLOWED_ORIGINS=https://example.com,chrome-extension://replace-with-extension-id
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h
AWS_REGION=ap-northeast-2
AWS_ACCESS_KEY_ID=replace-with-scoped-iam-access-key
AWS_SECRET_ACCESS_KEY=replace-with-scoped-iam-secret
SCRAPE_REQUEST_QUEUE_URL=https://sqs.ap-northeast-2.amazonaws.com/ACCOUNT/remak-scrape-request
SCRAPE_RESULT_QUEUE_URL=https://sqs.ap-northeast-2.amazonaws.com/ACCOUNT/remak-scrape-result
ARTIFACT_BUCKET=remak-artifacts
DOCUMENT_BUCKET=remak-documents
EMAIL_FROM=no-reply@example.com
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=replace-me
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
CHAT_MODEL=gpt-4.1-mini
QUEUE_POLL_WAIT=10s
OUTBOX_POLL_INTERVAL=1s
MAX_DOCUMENT_UPLOAD_BYTES=104857600
ENRICHMENT_BATCH_SIZE=4
